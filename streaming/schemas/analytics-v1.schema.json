{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EquityLens derived analytics notification v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "eventType",
    "analyticsKind",
    "eventId",
    "symbol",
    "provider",
    "feed",
    "synthetic",
    "window_start"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "eventType": {
      "const": "MARKET_ANALYTICS"
    },
    "analyticsKind": {
      "enum": [
        "REFERENCE_STATE",
        "ROLLING_TRADE_METRICS"
      ]
    },
    "eventId": {
      "type": "string"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9.-]{0,9}$"
    },
    "provider": {
      "type": "string"
    },
    "feed": {
      "type": "string"
    },
    "synthetic": {
      "type": "boolean"
    },
    "window_start": {
      "type": "string",
      "format": "date-time"
    },
    "window_end": {
      "type": "string",
      "format": "date-time"
    },
    "price": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "anomaly": {
      "type": "boolean"
    },
    "return_1m_pct": {
      "type": [
        "number",
        "null"
      ]
    },
    "return_5m_pct": {
      "type": [
        "number",
        "null"
      ]
    },
    "rolling_volume": {
      "type": [
        "number",
        "null"
      ]
    },
    "rolling_vwap": {
      "type": [
        "number",
        "null"
      ]
    },
    "volatility_pct": {
      "type": [
        "number",
        "null"
      ]
    },
    "volume_ratio": {
      "type": [
        "number",
        "null"
      ]
    }
  }
}
