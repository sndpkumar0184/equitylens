{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://equitylens.local/schemas/market-event-v1.json",
  "title": "EquityLens canonical market event v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "symbol",
    "eventTime",
    "receivedAt",
    "provider",
    "feed",
    "sourceMetadata",
    "data"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "enum": [
        "TRADE",
        "QUOTE",
        "BAR",
        "REFERENCE_PRICE"
      ]
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9.-]{0,9}$"
    },
    "eventTime": {
      "type": "string",
      "format": "date-time"
    },
    "receivedAt": {
      "type": "string",
      "format": "date-time"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "feed": {
      "type": "string",
      "minLength": 1
    },
    "exchange": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceMetadata": {
      "type": "object",
      "properties": {
        "synthetic": {
          "type": "boolean"
        }
      }
    },
    "data": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "TRADE"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "price",
              "quantity"
            ],
            "properties": {
              "price": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "quantity": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "REFERENCE_PRICE"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "price"
            ],
            "properties": {
              "price": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "QUOTE"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "sizeUnit"
            ],
            "properties": {
              "bidPrice": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "bidSize": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "askPrice": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "askSize": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "sizeUnit": {
                "enum": [
                  "SHARES",
                  "ROUND_LOTS"
                ]
              },
              "bidExchange": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "askExchange": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "anyOf": [
              {
                "required": [
                  "bidPrice"
                ],
                "properties": {
                  "bidPrice": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              {
                "required": [
                  "askPrice"
                ],
                "properties": {
                  "askPrice": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "BAR"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "interval",
              "open",
              "high",
              "low",
              "close",
              "volume"
            ],
            "properties": {
              "interval": {
                "const": "1m"
              },
              "open": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "high": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "low": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "close": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "volume": {
                "type": "number",
                "minimum": 0
              },
              "vwap": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider": {
            "const": "SYNTHETIC"
          }
        }
      },
      "then": {
        "properties": {
          "sourceMetadata": {
            "required": [
              "synthetic"
            ],
            "properties": {
              "synthetic": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
