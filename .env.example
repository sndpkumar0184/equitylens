# Local development only. Set a unique password before exposing any service.
POSTGRES_DB=equitylens
POSTGRES_USER=equitylens
POSTGRES_PASSWORD=replace_with_local_password
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/equitylens
SEC_USER_AGENT="EquityLens contact@example.com"
FINNHUB_API_KEY=
MARKET_DATA_PROVIDER=stashgamma
STASHGAMMA_API_KEY=
MCP_ENABLED=true
AI_ENABLED=true
AI_PROVIDER=local
AI_LOCAL_URL=http://127.0.0.1:11434
