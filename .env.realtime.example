# Compose environment example; do not source directly (some values contain spaces).
# Export backend settings separately. Match the database credentials in your root .env.
REALTIME_ENABLED=false
REALTIME_LIVE_ENABLED=true
REALTIME_MARKET_PROVIDER=alpaca
REALTIME_SYMBOLS=AAPL,META,AMZN,NVDA
REALTIME_MAX_SYMBOLS=30
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_FEED=iex
ALPACA_STREAM_URL=wss://stream.data.alpaca.markets/v2/iex
ALPACA_CHANNELS=TRADES,QUOTES,BARS
TIINGO_API_TOKEN=
TIINGO_STREAM_URL=wss://api.tiingo.com/iex
TIINGO_THRESHOLD_LEVEL=6
REALTIME_ANALYTICS_PROVIDER=ALPACA
REALTIME_ANALYTICS_FEED=IEX
REALTIME_ANALYTICS_SYNTHETIC=false
STREAMING_ALLOW_SYNTHETIC=false
STREAMING_DATABASE_URL=postgresql://equitylens:replace_with_local_password@postgres:5432/equitylens
SPARK_WATERMARK=2 minutes
SPARK_MAX_OFFSETS=10000
KAFKA_RETENTION_MS=86400000
KAFKA_RETENTION_HOURS=24
KAFKA_PARTITIONS=4
